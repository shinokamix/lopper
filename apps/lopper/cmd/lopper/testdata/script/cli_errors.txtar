# fang capitalizes and wraps errors, so the patterns ignore case and the
# start of the path.

! exec lopper scan /nonexistent
stderr '(?i)nonexistent: no such directory'
! stdout .

! exec lopper scan nonexistent
stderr '(?i)nonexistent: no such directory'
! stdout .

! exec lopper scan file.txt
stderr '(?i)file.txt: not a directory'
! stdout .

-- file.txt --
not a directory
