exec git init -q repo
exec git -C repo commit -q --allow-empty -m init
exec git -C repo worktree add -q -b feature ../agent/wt
rm repo

exec lopper scan --json $WORK
# JSON escapes the Windows separator as \\.
stdout '"path": ".*agent(/|\\\\)wt"'
stdout '"safe": false'
stdout '"orphaned": true'
stdout '"size_bytes": '
! stdout '"safe": true'
! stdout '"errors"'
! stderr .

exec lopper scan $WORK/agent
stdout '^unsafe\s+.*agent[/\\]wt$'

exec git init -q $WORK/outside/kept
exec git -C $WORK/outside/kept commit -q --allow-empty -m init
exec git -C $WORK/outside/kept worktree add -q -b pruned $WORK/tree/pruned
exec git -C $WORK/outside/kept worktree add -q -b other $WORK/elsewhere/other
rm $WORK/outside/kept/.git/worktrees/pruned

exec lopper scan $WORK/tree
stdout -count=2 '^\w+\s'
stdout '^unsafe\s+.*tree[/\\]pruned$'
stdout '^\w+\s+other\s'

exec git init -q $WORK/sub/lib
exec git -C $WORK/sub/lib commit -q --allow-empty -m init
exec git init -q $WORK/sub/super
exec git -C $WORK/sub/super -c protocol.file.allow=always submodule add -q ../lib worktrees/lib
exec lopper scan $WORK/sub
! stdout .

rm $WORK/sub/super/.git/modules/worktrees/lib

exec lopper scan $WORK/sub
! stdout .

rm $WORK/sub/super/.git/modules

exec lopper scan $WORK/sub
! stdout .
