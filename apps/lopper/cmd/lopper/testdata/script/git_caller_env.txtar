exec git init -q repo
exec git -C repo commit -q --allow-empty -m init
exec git -C repo worktree add -q -b wip ../scanned/wt
cp dirty.txt scanned/wt/dirty.txt
exec git init -q caller
exec git -C caller commit -q --allow-empty -m init

env GIT_DIR=$WORK/caller/.git
env GIT_WORK_TREE=$WORK/caller
exec lopper scan --json $WORK/scanned
stdout '"branch": "wip"'
stdout '"safe": false'
stdout '"dirty": 1'

-- dirty.txt --
not committed yet
