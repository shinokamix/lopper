exec git init -q repo
exec git -C repo commit -q --allow-empty -m init
exec git -C repo worktree add -q -b plain ../wt-plain

exec git -C repo worktree add -q -b odd ../wt-odd
env 'GIT_COMMITTER_DATE=@1700000000 +2400'
exec git -C wt-odd commit -q --allow-empty -m odd
env GIT_COMMITTER_DATE=

exec lopper scan --json $WORK
stdout '"last_commit": "2023-11-14T22:13:20Z"'
stdout 'wt-plain'
! stderr .
