# A worktree whose status cannot be read is never reported as safe, even
# when its branch is merged: the facts say what is unknown and why.

exec git init -q repo
exec git -C repo commit -q --allow-empty -m init
exec git -C repo worktree add -q -b merged ../wt-merged

# Corrupt the worktree's index: `git status` fails, history stays readable.
cp garbage.txt repo/.git/worktrees/wt-merged/index
! exec git -C wt-merged status --porcelain

exec lopper scan --json $WORK
stdout '"safe": false'
! stdout '"safe": true'
stdout '"could not read status: '
stdout '"merged": "ancestor"'
! stdout '"dirty"'

exec lopper scan $WORK
stdout '^unsafe\s+merged\s'

-- garbage.txt --
not an index
