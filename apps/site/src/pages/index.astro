---
import Layout from "../components/Layout.astro";
import demo from "../../../lopper/docs/demo.mp4";

const description =
  "lopper finds Git worktrees all over the disk, shows how much space each one takes and removes the ones whose work is merged.";

const ways = [
  {
    id: "unix",
    label: "macOS, Linux",
    prompt: "$",
    command:
      "curl -fsSL https://raw.githubusercontent.com/shinokamix/lopper/main/install.sh | sh",
  },
  {
    id: "windows",
    label: "Windows",
    prompt: ">",
    command:
      "irm https://raw.githubusercontent.com/shinokamix/lopper/main/install.ps1 | iex",
  },
  {
    id: "go",
    label: "Go",
    prompt: "$",
    command:
      "go install github.com/shinokamix/lopper/apps/lopper/cmd/lopper@latest",
  },
];

const usage = [
  ["lopper", "interactive UI, scans home and temporary directories"],
  ["lopper ~/code", "scan a specific directory"],
  ["lopper scan --json", "JSON output"],
  ["lopper rm ../wt", "remove if safe, --force otherwise"],
  ["lopper update", "update to the latest release"],
]
  // Built as one string, since Astro keeps template line breaks inside pre.
  .map(
    ([command, note]) =>
      `${command.padEnd(20)}<span class="dim"># ${note}</span>`,
  )
  .join("\n");
---

<Layout
  title="lopper: clean up the Git worktrees you and your agents left behind"
  description={description}
>
  <main>
    <section class="row wide hero">
      <h1>Clean up the Git worktrees you and your agents left behind.</h1>
      <p class="dim">
        Finds worktrees anywhere on the disk, shows how much space each takes
        and removes only the ones whose work is merged. Branches stay.
      </p>
    </section>

    <section class="row wide demo">
      <div class="window">
        <div class="bar" aria-hidden="true">
          <span class="lights">
            <i></i>
            <i></i>
            <i></i>
          </span>
          <span>~/code</span>
        </div>
        <video
          src={demo}
          poster="/poster.png"
          width="1200"
          height="672"
          autoplay
          muted
          loop
          playsinline
          aria-label="lopper removes four merged worktrees and, after a warning, two with uncommitted work"
        ></video>
      </div>
    </section>

    <section class="row">
      <h2 class="label">install</h2>
      <div class="install">
        <fieldset aria-label="Install with">
          {ways.map((w, i) => (
            <label>
              <input type="radio" name="way" value={w.id} checked={i === 0} />
              {w.label}
            </label>
          ))}
        </fieldset>
        <div class="code">
          {ways.map((w) => <pre
            data-way={w.id}
            data-prompt={w.prompt}
          ><code>{w.command}</code></pre>)}
          <button type="button" aria-live="polite">
            Copy
          </button>
        </div>
      </div>
    </section>

    <section class="row">
      <h2 class="label">usage</h2>
      <pre><code set:html={usage} /></pre>
    </section>

    <section class="row">
      <h2 class="label">faq</h2>
      <div class="faq">
        <details name="faq">
          <summary>Does it delete my branches?</summary>
          <p>
            No. lopper removes a worktree with <code>git worktree remove</code>,
            which deletes the folder and keeps the branch and its commits. You
            can check the branch out again at any time.
          </p>
        </details>
        <details name="faq">
          <summary>Which worktrees does it remove?</summary>
          <p>
            Only those whose changes are already in the base branch and that
            hold nothing uncommitted. lopper sees the changes whether they
            arrived by a merge, a squash, a rebase or a cherry-pick. A worktree
            with uncommitted or unpushed work goes only after a warning, or with
            <code>lopper rm --force</code>. Locked and moved worktrees count as
            unsafe, since Git cannot check them.
          </p>
        </details>
        <details name="faq">
          <summary>What is the base branch?</summary>
          <p>
            The branch <code>origin/HEAD</code> points to. A repository without
            it uses <code>main</code>, and then <code>master</code>.
          </p>
        </details>
        <details name="faq">
          <summary>Where does the space come from?</summary>
          <p>
            Each worktree has its own <code>node_modules</code>,
            <code>.venv</code> or <code>target/</code>. Git deletes these
            ignored files together with the worktree, so the space comes back.
          </p>
        </details>
        <details name="faq">
          <summary>Will it find the worktrees my agent created?</summary>
          <p>
            Yes. lopper walks your home and temporary directories, so it finds
            worktrees wherever a tool put them. <code>lopper ~/code</code> scans
            one directory instead.
          </p>
        </details>
        <details name="faq">
          <summary>Does it use the network?</summary>
          <p>
            Only to check GitHub for a new release, in the background.
            <code>LOPPER_NO_UPDATE_CHECK=1</code> turns the check off.
          </p>
        </details>
      </div>
    </section>
  </main>
</Layout>

<script>
  if (navigator.userAgent.includes("Windows")) {
    document.querySelector<HTMLInputElement>('[value="windows"]')!.checked =
      true;
  }

  const button = document.querySelector<HTMLButtonElement>(".install button")!;
  button.addEventListener("click", async () => {
    const way = document.querySelector<HTMLInputElement>("[name=way]:checked")!;
    const code = document.querySelector(`[data-way="${way.value}"] code`)!;
    try {
      await navigator.clipboard.writeText(code.textContent!);
      button.textContent = "Copied";
      setTimeout(() => (button.textContent = "Copy"), 1500);
    } catch {
      // The clipboard API needs a secure context and permission. Selecting
      // the command leaves the copy to the visitor.
      getSelection()!.selectAllChildren(code);
    }
  });

  // Autoplay ignores the reduced motion setting.
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const video = document.querySelector("video")!;
    video.pause();
    video.controls = true;
  }
</script>

<style>
  .hero p {
    margin-top: 1rem;
    max-width: 34rem;
  }

  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 1rem;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
  }

  label {
    color: var(--dim);
    cursor: pointer;
  }

  label:has(:checked) {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  label:has(:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  input {
    position: absolute;
    opacity: 0;
  }

  .code {
    position: relative;
  }

  .install pre {
    display: none;
    position: relative;
    padding-left: 2.25rem;
    /* Keeps the end of a long command clear of the button. */
    padding-right: 4.5rem;
    /* A command wraps rather than scrolls, and Copy takes it whole. */
    white-space: pre-wrap;
    word-break: break-all;
  }

  .install pre::before {
    content: attr(data-prompt);
    position: absolute;
    left: 1rem;
    color: var(--accent);
    user-select: none;
  }

  .install:has([value="unix"]:checked) [data-way="unix"],
  .install:has([value="windows"]:checked) [data-way="windows"],
  .install:has([value="go"]:checked) [data-way="go"] {
    display: block;
  }

  button {
    position: absolute;
    top: calc(1rem + 1px);
    right: 1px;
    border: 0;
    padding: 0 1rem 0 0.5rem;
    background: var(--band);
    color: var(--dim);
    font: inherit;
    font-size: 0.875rem;
    line-height: 1.6;
    cursor: pointer;
  }

  button:hover {
    color: var(--fg);
  }

  .demo {
    position: relative;
  }

  /* A faint light behind the window, in the purple of merged worktrees. */
  .demo::before {
    content: "";
    position: absolute;
    inset: -15% -10% 5%;
    z-index: -1;
    background: radial-gradient(
      closest-side,
      light-dark(#8250df1a, #a371f729),
      transparent
    );
    pointer-events: none;
  }

  /* The window stays dark in both themes, since the recording is dark. */
  .window {
    overflow: hidden;
    border: 1px solid light-dark(#0000001f, #ffffff1a);
    border-radius: 12px;
    background: #0f1115;
    box-shadow:
      0 1px 2px #0000000f,
      0 24px 48px -24px light-dark(#00000059, #000000b3);
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0.625rem 0.875rem;
    border-bottom: 1px solid #ffffff12;
    color: #8b8b94;
    font: 0.75rem/1 var(--mono);
  }

  .lights {
    display: flex;
    gap: 0.5rem;
  }

  .lights i {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: #ffffff1f;
  }

  video {
    display: block;
    width: 100%;
    height: auto;
  }

  .faq {
    border-top: 1px solid var(--line);
  }

  details {
    border-bottom: 1px solid var(--line);
    /* Lets the panel animate to its natural height where supported. */
    interpolate-size: allow-keywords;
  }

  details::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.2s ease,
      content-visibility 0.2s allow-discrete;
  }

  details[open]::details-content {
    block-size: auto;
  }

  summary {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: "+";
    font-family: var(--mono);
    color: var(--dim);
  }

  details[open] summary::after {
    content: "−";
  }

  details p {
    padding-bottom: 1rem;
    color: var(--dim);
  }

  details code {
    font-size: 0.875em;
    color: var(--fg);
    white-space: nowrap;
  }
</style>
