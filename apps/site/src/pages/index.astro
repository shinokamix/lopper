---
import Layout from "../components/Layout.astro";
import demo from "../../../lopper/docs/demo.mp4";

const description =
  "lopper shows every Git worktree on your disk in one list, with its size and whether its work is merged, and asks before it removes uncommitted or unpushed work.";

const ways = [
  {
    id: "unix",
    label: "macOS, Linux",
    prompt: "$",
    command:
      "curl -fsSL https://raw.githubusercontent.com/shinokamix/lopper/main/install.sh | sh",
  },
  {
    id: "windows",
    label: "Windows",
    prompt: ">",
    command:
      "irm https://raw.githubusercontent.com/shinokamix/lopper/main/install.ps1 | iex",
  },
  {
    id: "go",
    label: "Go",
    prompt: "$",
    command:
      "go install github.com/shinokamix/lopper/apps/lopper/cmd/lopper@latest",
  },
];

const commands = [
  ["lopper", "interactive UI, scans home and temporary directories"],
  ["lopper ~/code", "scan a specific directory"],
  ["lopper scan --json", "JSON output"],
  ["lopper rm ../wt", "remove if safe, --force otherwise"],
  ["lopper update", "update to the latest release"],
];

// Built as one string, since Astro keeps template line breaks inside pre.
const usage = commands
  .map(
    ([command, note]) =>
      `${command.padEnd(20)}<span class="dim"># ${note}</span>`,
  )
  .join("\n");

// Answers are HTML strings, so that a formatter cannot change the spacing
// around their code.
const faq = [
  [
    "Does it delete my branches?",
    "No. lopper runs <code>git worktree remove</code>, which deletes the folder and leaves the branch and its commits alone. You can check the branch out again whenever you like.",
  ],
  [
    "Which worktrees does it remove?",
    "A worktree is safe to remove when its changes are already in the base branch and nothing in it is uncommitted. lopper notices merged work even after a squash, a rebase or a cherry-pick. A worktree with uncommitted or unpushed work goes only after you confirm a warning, or with <code>lopper rm --force</code>. Git cannot check locked or moved worktrees, so lopper treats them as unsafe.",
  ],
  [
    "What is the base branch?",
    "The branch <code>origin/HEAD</code> points to. A repository without it uses <code>main</code>, and then <code>master</code>.",
  ],
  [
    "Where does the space come from?",
    "Each worktree has its own <code>node_modules</code>, <code>.venv</code> or <code>target/</code>. Git ignores these files but deletes them with the worktree, so you get the space back.",
  ],
  [
    "Will it find the worktrees my agent created?",
    "Yes. lopper walks your home and temporary directories, so it finds worktrees wherever a tool put them. To scan one directory, run <code>lopper ~/code</code>.",
  ],
  [
    "Does it use the network?",
    "Only to check GitHub for a new release, in the background. Set <code>LOPPER_NO_UPDATE_CHECK=1</code> to turn that off.",
  ],
];
---

<Layout
  title="lopper: clean up the Git worktrees you and your agents left behind"
  description={description}
>
  <main>
    <section>
      <h1>A cleaner for Git worktrees.</h1>
      <p class="lede dim">
        Coding agents leave Git worktrees all over your disk. lopper finds them
        and cleans up the ones you're done with.
      </p>
      <h2>install</h2>
      <div class="install">
        <fieldset aria-label="Install with">
          {ways.map((w, i) => (
            <label>
              <input type="radio" name="way" value={w.id} checked={i === 0} />
              {w.label}
            </label>
          ))}
        </fieldset>
        <div class="command">
          {ways.map((w) => <pre
            data-way={w.id}
            data-prompt={w.prompt}
          ><code>{w.command}</code></pre>)}
          <button type="button" aria-live="polite">
            Copy
          </button>
        </div>
      </div>
    </section>

    <section class="demo">
      <video
        src={demo}
        poster="/poster.png"
        width="1200"
        height="672"
        autoplay
        muted
        loop
        playsinline
        aria-label="lopper removes four merged worktrees and, after a warning, two with uncommitted work"
      ></video>
    </section>

    <section>
      <h2>about</h2>
      <p>
        Worktrees pile up. You make some by hand, a coding agent makes one for
        every task, and each tool puts them in its own folder. Every worktree is
        a full copy of the project with its own <code>node_modules</code>,
        <code>.venv</code> or Rust <code>target/</code>, so a few of them can
        take gigabytes.
      </p>
      <p>
        Git lists worktrees one repository at a time. Nothing tells you how many
        you have, which repository each belongs to or how much space they take.
      </p>
      <p>
        lopper walks your home and temporary directories, finds them all and
        groups them by repository. Worktrees whose work is merged are marked in
        purple, so you can tell which ones are safe to remove.
      </p>
    </section>

    <section>
      <h2>usage</h2>
      <pre><code set:html={usage} /></pre>
    </section>

    <section>
      <h2>faq</h2>
      {faq.map(([question, answer]) => (
        <details name="faq">
          <summary>{question}</summary>
          <p set:html={answer} />
        </details>
      ))}
    </section>
  </main>
</Layout>

<script>
  if (navigator.userAgent.includes("Windows")) {
    document.querySelector<HTMLInputElement>('[value="windows"]')!.checked =
      true;
  }

  const button = document.querySelector<HTMLButtonElement>(".install button")!;
  button.addEventListener("click", async () => {
    const way = document.querySelector<HTMLInputElement>("[name=way]:checked")!;
    const code = document.querySelector(`[data-way="${way.value}"] code`)!;
    try {
      await navigator.clipboard.writeText(code.textContent!);
      button.textContent = "Copied";
      setTimeout(() => (button.textContent = "Copy"), 1500);
    } catch {
      // The clipboard API needs a secure context and permission. Selecting
      // the command leaves the copy to the visitor.
      getSelection()!.selectAllChildren(code);
    }
  });

  // Autoplay ignores the reduced motion setting.
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const video = document.querySelector("video")!;
    video.pause();
    video.controls = true;
  }
</script>

<style>
  .lede {
    margin-top: 1lh;
  }

  h2 {
    margin-bottom: 1lh;
  }

  .lede + h2 {
    margin-top: 2lh;
  }

  p + p {
    margin-top: 1lh;
  }

  .install {
    background: var(--band);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  fieldset {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0.75rem 1.25rem;
    border: 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.875rem;
  }

  label {
    color: var(--dim);
    cursor: pointer;
    user-select: none;
  }

  label:hover {
    color: var(--fg);
  }

  label:has(:checked) {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.5em;
    cursor: default;
  }

  label:has(:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  /* The radio stays focusable but covers none of the label, so the whole
     label shows the hand cursor. */
  input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }

  .command {
    display: flex;
    align-items: baseline;
  }

  .command pre {
    display: none;
    flex: 1;
    min-width: 0;
    position: relative;
    padding-left: 2.5rem;
    background: none;
    border: 0;
  }

  .command pre::before {
    content: attr(data-prompt);
    position: absolute;
    left: 1.25rem;
    color: var(--accent);
    user-select: none;
  }

  .install:has([value="unix"]:checked) [data-way="unix"],
  .install:has([value="windows"]:checked) [data-way="windows"],
  .install:has([value="go"]:checked) [data-way="go"] {
    display: block;
  }

  button {
    padding: 0 1.25rem;
    border: 0;
    background: none;
    color: var(--dim);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  button:hover {
    color: var(--fg);
  }

  /* The recording fills the frame on its own background, so it needs no
     window around it. */
  .demo {
    padding: 0;
    background: #0f1014;
  }

  video {
    display: block;
    width: 100%;
    height: auto;
  }

  details {
    /* Lets the panel animate to its natural height where supported. */
    interpolate-size: allow-keywords;
  }

  details::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.2s ease,
      content-visibility 0.2s allow-discrete;
  }

  details[open]::details-content {
    block-size: auto;
  }

  /* A row under the pointer gets the band the lopper list draws under its
     cursor, across the whole frame. An open question is bold, like a
     selected row. */
  summary {
    display: flex;
    gap: 1.5ch;
    margin-inline: calc(-1 * var(--pad));
    padding: 0.25lh var(--pad);
    cursor: pointer;
    list-style: none;
  }

  summary:hover,
  summary:focus-visible {
    background: var(--cursor);
    outline: 0;
  }

  details[open] summary {
    font-weight: 700;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::before {
    content: "+";
    color: var(--dim);
  }

  summary:hover::before,
  details[open] summary::before {
    color: var(--fg);
  }

  details[open] summary::before {
    content: "−";
  }

  details p {
    padding: 0.5lh 0 1lh 2.5ch;
    color: var(--dim);
  }

  details code {
    color: var(--fg);
    white-space: nowrap;
  }
</style>
