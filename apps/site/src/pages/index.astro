---
import Layout from "../components/Layout.astro";
import demo from "@lopper/demo/demo.mp4";

const description =
  "Find stale Git worktrees across all your repositories, see their disk usage and status, and clean up the ones you no longer need. Works with any coding agent or worktree tool, including Claude Code, Codex and Cursor.";

const ways = [
  {
    id: "unix",
    label: "macOS, Linux",
    prompt: "$",
    command: "curl -fsSL https://lopper.dev/install.sh | sh",
  },
  {
    id: "windows",
    label: "Windows",
    prompt: ">",
    command: "irm https://lopper.dev/install.ps1 | iex",
  },
  {
    id: "go",
    label: "Go",
    prompt: "$",
    command:
      "go install github.com/shinokamix/lopper/apps/lopper/cmd/lopper@latest",
  },
];

const commands: [string, string][] = [
  ["lopper", "open the terminal UI"],
  ["lopper ~/code", "scan a specific directory"],
  ["lopper scan --json", "print scan results as JSON"],
  ["lopper rm ../wt", "remove a worktree if safe"],
  ["lopper update", "update to the latest release"],
];
---

<Layout
  title="lopper: clean up stale Git worktrees across your repositories"
  description={description}
>
  <main>
    <section>
      <h1>lopper</h1>
      <p class="lede dim">
        Find stale Git worktrees across all your repositories, see their disk
        usage and status, and clean up the ones you no longer need.
      </p>
      <h2>install</h2>
      <form class="install" autocomplete="off">
        <fieldset aria-label="Install with">
          {ways.map((w, i) => (
            <label>
              <input type="radio" name="way" value={w.id} checked={i === 0} />
              {w.label}
            </label>
          ))}
        </fieldset>
        {/* This script runs right after the radios, so Windows visitors never
             see the curl command. With autocomplete off, the browser does not
             restore an older choice over the one the script makes. */}
        <script is:inline>
          if (navigator.userAgent.includes("Windows")) {
            document.querySelector('[value="windows"]').checked = true;
          }
        </script>
        <div class="command">
          {ways.map((w) => <pre
            data-way={w.id}
            data-prompt={w.prompt}
          ><code>{w.command}</code></pre>)}
          <button type="button" aria-live="polite">
            Copy
          </button>
        </div>
        <p class="copy-status dim" role="status"></p>
      </form>
    </section>

    <section class="demo">
      <video
        src={demo}
        width="2400"
        height="1440"
        autoplay
        muted
        loop
        playsinline
        aria-label="Demo of lopper removing merged worktrees and warning before removing uncommitted work"
      ></video>
    </section>

    <section>
      <h2>why lopper</h2>
      <p>
        Worktrees pile up all over the disk. You make some by hand, and coding
        agents make one per task, each tool in its own folder. Every worktree
        has its own <code>node_modules</code>, <code>.venv</code> or{" "}
        <code>target/</code>, and can take up gigabytes.
      </p>
      <p>
        Git lists them one repository at a time, and you have to check each one
        yourself before deleting it. lopper finds them all and shows each one's
        size and status, so you know what's safe to delete.
      </p>
    </section>

    <section>
      <h2>commands</h2>
      <pre><code>{commands.map(([command, note], i) => <>{i > 0 && "\n"}{command.padEnd(20)}<span class="dim"># {note}</span></>)}</code></pre>
    </section>

    <section>
      <h2>faq</h2>
      <details name="faq">
        <summary>Can it delete unfinished work?</summary>
        <p>
          Not without asking. lopper warns you about uncommitted or unmerged
          work, and <code>lopper rm</code> needs <code>--force</code> for it.
        </p>
      </details>
      <details name="faq">
        <summary>How does removal work?</summary>
        <p>
          lopper checks the worktree again right before removing it, in case it
          changed since the scan. Then it runs <code>git worktree remove</code>,
          which deletes the folder and Git's record of it but keeps the branch.
          There is no trash, so the folder is gone for good.
        </p>
      </details>
      <details name="faq">
        <summary>Where does it look?</summary>
        <p>
          Everywhere under your home and temp folders, hidden ones too. lopper
          doesn't look for specific tools, so it finds worktrees from Claude
          Code, Codex, Cursor, T3 Code, Orca, Paseo or whatever comes next.
        </p>
      </details>
      <details name="faq">
        <summary>Does it go online?</summary>
        <p>
          Only to check GitHub for updates.{" "}
          <code>LOPPER_NO_UPDATE_CHECK=1</code> turns that off.
        </p>
      </details>
    </section>
  </main>
</Layout>

<script>
  const button = document.querySelector<HTMLButtonElement>(".install button")!;
  const copyStatus =
    document.querySelector<HTMLParagraphElement>(".copy-status")!;
  let reset: ReturnType<typeof setTimeout> | undefined;
  function resetCopy() {
    clearTimeout(reset);
    button.textContent = "Copy";
    copyStatus.textContent = "";
  }

  document
    .querySelector(".install fieldset")!
    .addEventListener("change", resetCopy);
  button.addEventListener("click", async () => {
    const way = document.querySelector<HTMLInputElement>("[name=way]:checked")!;
    const code = document.querySelector(`[data-way="${way.value}"] code`)!;
    const copied = await navigator.clipboard.writeText(code.textContent!).then(
      () => true,
      () => false,
    );
    // The visitor may pick another command while the copy is pending.
    if (!way.checked) return;
    resetCopy();
    if (copied) {
      button.textContent = "Copied";
      reset = setTimeout(resetCopy, 1500);
    } else {
      getSelection()!.selectAllChildren(code);
      copyStatus.textContent =
        "Command selected. Copy it with your keyboard or context menu.";
    }
  });
</script>

<style>
  .lede {
    margin-top: 1lh;
  }

  h2 {
    margin-bottom: 1lh;
  }

  .lede + h2 {
    margin-top: 2lh;
  }

  p + p {
    margin-top: 1lh;
  }

  .install {
    background: var(--band);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .copy-status {
    font-size: 0.875rem;
  }

  .copy-status:not(:empty) {
    padding: 0 1.25rem 0.75rem;
  }

  fieldset {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0.75rem 1.25rem;
    border: 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.875rem;
  }

  label {
    color: var(--dim);
    cursor: pointer;
    user-select: none;
  }

  label:hover {
    color: var(--fg);
  }

  label:has(:checked) {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.5em;
    cursor: default;
  }

  label:has(:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  /* The radio stays focusable but covers none of the label, so the whole
     label shows the hand cursor. */
  input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }

  .command {
    display: flex;
    align-items: baseline;
  }

  .command pre {
    display: none;
    flex: 1;
    min-width: 0;
    position: relative;
    padding-left: 2.5rem;
    background: none;
    border: 0;
  }

  .command pre::before {
    content: attr(data-prompt);
    position: absolute;
    left: 1.25rem;
    color: var(--accent);
    user-select: none;
  }

  .install:has([value="unix"]:checked) [data-way="unix"],
  .install:has([value="windows"]:checked) [data-way="windows"],
  .install:has([value="go"]:checked) [data-way="go"] {
    display: block;
  }

  button {
    padding: 0 1.25rem;
    border: 0;
    background: none;
    color: var(--dim);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  button:hover {
    color: var(--fg);
  }

  .demo {
    padding: 0;
    background: #0f1014;
  }

  video {
    display: block;
    width: 100%;
    height: auto;
  }

  summary {
    display: flex;
    gap: 1.5ch;
    margin-inline: calc(-1 * var(--pad));
    padding: 0.25lh var(--pad);
    cursor: pointer;
    list-style: none;
  }

  summary:hover,
  summary:focus-visible {
    background: var(--cursor);
    outline: 0;
  }

  details[open] summary {
    font-weight: 700;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::before {
    content: "+";
    color: var(--dim);
  }

  summary:hover::before,
  details[open] summary::before {
    color: var(--fg);
  }

  details[open] summary::before {
    content: "−";
  }

  details p {
    padding: 0.5lh 0 1lh 2.5ch;
    color: var(--dim);
  }

  details code {
    color: var(--fg);
    white-space: nowrap;
  }
</style>
