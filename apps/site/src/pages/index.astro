---
import Layout from "../components/Layout.astro";
import demo from "../../../lopper/docs/demo.mp4";

const description =
  "lopper finds Git worktrees all over the disk, shows how much space each one takes and removes the ones whose work is merged.";

const ways = [
  {
    id: "unix",
    label: "macOS, Linux",
    command:
      "curl -fsSL https://raw.githubusercontent.com/shinokamix/lopper/main/install.sh | sh",
  },
  {
    id: "windows",
    label: "Windows",
    command:
      "irm https://raw.githubusercontent.com/shinokamix/lopper/main/install.ps1 | iex",
  },
  {
    id: "go",
    label: "Go",
    command:
      "go install github.com/shinokamix/lopper/apps/lopper/cmd/lopper@latest",
  },
];

const usage = [
  ["lopper", "interactive UI, scans home and temporary directories"],
  ["lopper ~/code", "scan a specific directory"],
  ["lopper scan --json", "JSON output"],
  ["lopper rm ../wt", "remove if safe, --force otherwise"],
  ["lopper update", "update to the latest release"],
]
  // Built as one string, since Astro keeps template line breaks inside pre.
  .map(
    ([command, note]) =>
      `${command.padEnd(20)}<span class="dim"># ${note}</span>`,
  )
  .join("\n");
---

<Layout
  title="lopper: clean up the Git worktrees you and your agents left behind"
  description={description}
>
  <main>
    <section class="row hero">
      <h1>Clean up the Git worktrees you and your agents left behind.</h1>
      <p class="dim">
        Finds worktrees anywhere on the disk, shows how much space each takes
        and removes the ones whose work is merged.
      </p>
    </section>

    <section class="row wide">
      <video
        src={demo}
        poster="/poster.png"
        width="1200"
        height="672"
        autoplay
        muted
        loop
        playsinline
        aria-label="lopper removes four merged worktrees and, after a warning, two with uncommitted work"
      ></video>
    </section>

    <section class="row">
      <h2 class="label">install</h2>
      <div class="install">
        <fieldset aria-label="Install with">
          {ways.map((w, i) => (
            <label>
              <input type="radio" name="way" value={w.id} checked={i === 0} />
              {w.label}
            </label>
          ))}
        </fieldset>
        <div class="code">
          {ways.map((w) => <pre data-way={w.id}><code>{w.command}</code></pre>)}
          <button type="button" aria-live="polite">
            Copy
          </button>
        </div>
      </div>
    </section>

    <section class="row">
      <h2 class="label">usage</h2>
      <pre><code set:html={usage} /></pre>
    </section>

    <section class="row">
      <h2 class="label">faq</h2>
      <div class="faq">
        <details name="faq">
          <summary>Which worktrees does lopper remove?</summary>
          <p>
            Only those whose commits are in the base branch and that hold
            nothing uncommitted. A worktree with uncommitted or unpushed work
            goes only after a warning, or with <code>lopper rm --force</code>.
            Locked and moved worktrees count as unsafe, since Git cannot check
            them.
          </p>
        </details>
        <details name="faq">
          <summary>Does it notice squash merges?</summary>
          <p>
            Yes. lopper counts work as merged when the base branch has its
            changes, whether they arrived by a merge, a squash, a rebase or a
            cherry-pick.
          </p>
        </details>
        <details name="faq">
          <summary>Where does it look?</summary>
          <p>
            <code>lopper</code> scans your home and temporary directories.
            <code>lopper ~/code</code> scans one directory instead.
          </p>
        </details>
        <details name="faq">
          <summary>Does it use the network?</summary>
          <p>
            Only to check GitHub for a new release, in the background.
            <code>LOPPER_NO_UPDATE_CHECK=1</code> turns the check off.
          </p>
        </details>
        <details name="faq">
          <summary>Why is the second scan faster?</summary>
          <p>
            lopper remembers where it found repositories, in
            <code>lopper/repos.json</code> under your user cache directory, and
            lists their worktrees first. The cache changes only how soon
            worktrees appear, never which. <code>LOPPER_NO_CACHE=1</code> scans
            without it.
          </p>
        </details>
      </div>
    </section>
  </main>
</Layout>

<script>
  if (navigator.userAgent.includes("Windows")) {
    document.querySelector<HTMLInputElement>('[value="windows"]')!.checked =
      true;
  }

  const button = document.querySelector<HTMLButtonElement>(".install button")!;
  button.addEventListener("click", async () => {
    const way = document.querySelector<HTMLInputElement>("[name=way]:checked")!;
    const code = document.querySelector(`[data-way="${way.value}"] code`)!;
    try {
      await navigator.clipboard.writeText(code.textContent!);
      button.textContent = "Copied";
      setTimeout(() => (button.textContent = "Copy"), 1500);
    } catch {
      // The clipboard API needs a secure context and permission. Selecting
      // the command leaves the copy to the visitor.
      getSelection()!.selectAllChildren(code);
    }
  });

  // Autoplay ignores the reduced motion setting.
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const video = document.querySelector("video")!;
    video.pause();
    video.controls = true;
  }
</script>

<style>
  .hero p {
    margin-top: 1rem;
    max-width: 34rem;
  }

  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 1rem;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
  }

  label {
    color: var(--dim);
    cursor: pointer;
  }

  label:has(:checked) {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    text-underline-offset: 0.2em;
  }

  label:has(:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  input {
    position: absolute;
    opacity: 0;
  }

  .code {
    position: relative;
  }

  .install pre {
    display: none;
    /* Keeps the end of a long command clear of the button. */
    padding-right: 4.5rem;
  }

  .install:has([value="unix"]:checked) [data-way="unix"],
  .install:has([value="windows"]:checked) [data-way="windows"],
  .install:has([value="go"]:checked) [data-way="go"] {
    display: block;
  }

  button {
    position: absolute;
    top: 1rem;
    right: 0;
    border: 0;
    padding: 0 1rem 0 0.5rem;
    background: var(--band);
    color: var(--dim);
    font: inherit;
    font-size: 0.875rem;
    line-height: 1.6;
    cursor: pointer;
  }

  button:hover {
    color: var(--fg);
  }

  video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    background: #0f1115;
  }

  .faq {
    border-top: 1px solid color-mix(in srgb, var(--fg) 10%, transparent);
  }

  details {
    border-bottom: 1px solid color-mix(in srgb, var(--fg) 10%, transparent);
    /* Lets the panel animate to its natural height where supported. */
    interpolate-size: allow-keywords;
  }

  details::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.2s ease,
      content-visibility 0.2s allow-discrete;
  }

  details[open]::details-content {
    block-size: auto;
  }

  summary {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: "+";
    font-family: var(--mono);
    color: var(--dim);
  }

  details[open] summary::after {
    content: "−";
  }

  details p {
    padding-bottom: 1rem;
    color: var(--dim);
  }

  details code {
    font-size: 0.875em;
    color: var(--fg);
    white-space: nowrap;
  }
</style>
