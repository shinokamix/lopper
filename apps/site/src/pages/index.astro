---
import Layout from "../components/Layout.astro";
import demo from "../../../lopper/docs/demo.mp4";

const description =
  "lopper finds Git worktrees all over the disk, shows how much space each one takes and removes the ones whose work is merged.";

const ways = [
  {
    id: "unix",
    label: "macOS, Linux",
    command:
      "curl -fsSL https://raw.githubusercontent.com/shinokamix/lopper/main/install.sh | sh",
  },
  {
    id: "windows",
    label: "Windows",
    command:
      "irm https://raw.githubusercontent.com/shinokamix/lopper/main/install.ps1 | iex",
  },
  {
    id: "go",
    label: "Go",
    command:
      "go install github.com/shinokamix/lopper/apps/lopper/cmd/lopper@latest",
  },
];

// Worktrees from the demo recording, so the list matches the video.
const pruned = [
  {
    path: "storefront/feat/WEB-142-checkout",
    note: "merged",
    size: "432.0 MB",
  },
  {
    path: "storefront/feat/WEB-158-search",
    note: "1 unpushed",
    size: "417.3 MB",
  },
  {
    path: "mobile-app/feat/MOB-204-onboarding",
    note: "merged",
    size: "545.3 MB",
  },
  {
    path: "mobile-app/feat/MOB-219-push",
    note: "1 uncommitted",
    size: "529.5 MB",
  },
  {
    path: "billing-api/fix/API-87-token-refresh",
    note: "merged",
    size: "192.9 MB",
  },
];

const usage = `lopper              # interactive UI, scans home and temporary directories
lopper ~/code       # scan a specific directory
lopper scan --json  # JSON output
lopper rm ../wt     # remove if safe, --force otherwise
lopper update       # update to the latest release`;
---

<Layout
  title="lopper: clean up the Git worktrees you and your agents left behind"
  description={description}
>
  <main>
    <section class="row hero">
      <h1>Clean up the Git worktrees you and your agents left behind.</h1>
      <p class="dim">{description}</p>
    </section>

    <section class="row">
      <h2 class="label">install</h2>
      <div class="install">
        <div class="tabs">
          <fieldset aria-label="Install with">
            {ways.map((w, i) => (
              <label>
                <input type="radio" name="way" value={w.id} checked={i === 0} />
                {w.label}
              </label>
            ))}
          </fieldset>
          <button type="button" aria-live="polite">
            Copy
          </button>
        </div>
        {ways.map((w) => <pre data-way={w.id}><code>{w.command}</code></pre>)}
      </div>
    </section>

    <section class="row wide">
      <h2 class="label">demo</h2>
      <video
        src={demo}
        poster="/poster.png"
        width="1200"
        height="672"
        autoplay
        muted
        loop
        playsinline
        aria-label="lopper removes four merged worktrees and, after a warning, two with uncommitted work"
      ></video>
    </section>

    <section class="row">
      <h2 class="label">what it removes</h2>
      <div>
        <ul class="pruned">
          {pruned.map((w) => (
            <li class={w.note === "merged" ? "gone" : "kept"}>
              <span class="path">{w.path}</span>
              <span class="note">{w.note}</span>
              <span class="size">{w.size}</span>
            </li>
          ))}
          <li class="total">
            <span>freed</span>
            <span class="size">1.2 GB</span>
          </li>
        </ul>
        <p class="dim">
          Only worktrees whose work is merged go without asking. Anything
          uncommitted or unpushed takes a warning or <code>--force</code>.
        </p>
      </div>
    </section>

    <section class="row">
      <h2 class="label">usage</h2>
      <pre><code>{usage}</code></pre>
    </section>
  </main>
</Layout>

<script>
  if (navigator.userAgent.includes("Windows")) {
    document.querySelector<HTMLInputElement>('[value="windows"]')!.checked =
      true;
  }

  const button = document.querySelector<HTMLButtonElement>(".install button")!;
  button.addEventListener("click", async () => {
    const way = document.querySelector<HTMLInputElement>("[name=way]:checked")!;
    const code = document.querySelector(`[data-way="${way.value}"] code`)!;
    try {
      await navigator.clipboard.writeText(code.textContent!);
      button.textContent = "Copied";
      setTimeout(() => (button.textContent = "Copy"), 1500);
    } catch {
      // The clipboard API needs a secure context and permission. Selecting
      // the command leaves the copy to the visitor.
      getSelection()!.selectAllChildren(code);
    }
  });

  // Autoplay ignores the reduced motion setting.
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const video = document.querySelector("video")!;
    video.pause();
    video.controls = true;
  }
</script>

<style>
  .hero {
    margin-top: 6rem;
  }

  .hero p {
    margin-top: 1.25rem;
    font-size: 1.0625rem;
    max-width: 34rem;
  }

  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 1.25rem;
    font-size: 0.875rem;
  }

  label {
    color: var(--dim);
    cursor: pointer;
  }

  label:has(:checked) {
    color: var(--fg);
  }

  label:has(:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  input {
    position: absolute;
    opacity: 0;
  }

  .tabs {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.6rem;
  }

  .install pre {
    display: none;
    padding-inline: 1rem;
    font-size: 0.75rem;
  }

  .install:has([value="unix"]:checked) [data-way="unix"],
  .install:has([value="windows"]:checked) [data-way="windows"],
  .install:has([value="go"]:checked) [data-way="go"] {
    display: block;
  }

  button {
    border: 0;
    background: none;
    color: var(--dim);
    font: inherit;
    font-size: 0.875rem;
    padding: 0;
    cursor: pointer;
  }

  button:hover {
    color: var(--fg);
  }

  video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
    background: #0f1115;
  }

  .pruned {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    font: 0.8125rem/2.1 var(--mono);
  }

  .pruned li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 5.5rem;
    gap: 0 1.5rem;
  }

  .path {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .size {
    text-align: right;
  }

  .gone .note {
    color: var(--merged);
  }

  .kept .note {
    color: var(--work);
  }

  .gone :is(.path, .size) {
    color: var(--dim);
    text-decoration: line-through 1px var(--merged);
  }

  .total {
    color: var(--dim);
  }

  .total .size {
    grid-column: 3;
    color: var(--fg);
  }

  .pruned + p {
    font-size: 0.9375rem;
  }

  @media (width < 36rem) {
    .pruned li {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .note {
      grid-row: 2;
      line-height: 1.2;
      margin-bottom: 0.6rem;
    }

    .total .size {
      grid-column: 2;
    }
  }
</style>
