---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>lopper social card</title>
  </head>
  <body>
    <main>
      <img src="/favicon.svg" alt="" width="256" height="256" />
      <div>
        <h1>lopper</h1>
        <p>A cleaner for Git worktrees.</p>
      </div>
    </main>
  </body>
</html>

<style>
  :global(astro-dev-toolbar) {
    display: none;
  }

  :global(html) {
    width: 1200px;
    height: 630px;
    overflow: hidden;
  }

  body {
    width: 1200px;
    max-width: none;
    height: 630px;
    min-height: 0;
    margin: 0;
    overflow: hidden;
    border: 0;
  }

  main {
    display: flex;
    align-items: center;
    gap: 64px;
    height: 100%;
    padding: 96px;
  }

  img {
    flex: none;
  }

  h1 {
    margin: 0 0 24px;
    font-size: 104px;
    line-height: 1.1;
  }

  p {
    color: var(--dim);
    font-size: 28px;
    line-height: 1.6;
    white-space: nowrap;
  }
</style>
