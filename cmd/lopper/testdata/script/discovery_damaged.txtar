# A worktree whose metadata is damaged is still found, and told apart from
# an orphan: its repository is known, but cannot confirm the worktree.
# Such a worktree is never safe.

# No commondir: git lists the worktree, but cannot work in it.
exec git init -q a/repo
exec git -C a/repo commit -q --allow-empty -m init
exec git -C a/repo worktree add -q -b feature $WORK/a/wt
rm a/repo/.git/worktrees/wt/commondir
exec lopper scan --json $WORK/a
stdout -count=1 '"path"'
stdout '"verdict": "review"'
stdout '"rule": "unconfirmed"'
stdout 'commondir is missing from '
! stdout '"rule": "orphaned"'
# ...also when the walk reaches only the worktree.
exec lopper scan --json $WORK/a/wt
stdout 'commondir is missing from '
stdout '"branch": "feature"'

# commondir names a directory that is gone: git lists the worktree but
# cannot work in it. Its intact sibling is unaffected.
exec git init -q b/repo
exec git -C b/repo commit -q --allow-empty -m init
exec git -C b/repo worktree add -q -b broken $WORK/b/broken
exec git -C b/repo worktree add -q -b sibling $WORK/b/sibling
cp nowhere b/repo/.git/worktrees/broken/commondir
exec lopper scan $WORK/b
stdout '^review\s+broken\s'
stdout '^safe\s+sibling\s'
exec lopper scan --json $WORK/b
stdout -count=1 '"rule": "unconfirmed"'
stdout 'commondir names .*nowhere is gone'

# The repository is no longer one: its objects are gone.
exec git init -q c/repo
exec git -C c/repo commit -q --allow-empty -m init
exec git -C c/repo worktree add -q -b feature $WORK/c/wt
rm c/repo/.git/objects
exec lopper scan --json $WORK/c
stdout -count=1 '"path"'
stdout 'its git directory .* is not a git repository'
! stdout '"rule": "orphaned"'

# No link back to the worktree: git leaves it out of `worktree list`, yet
# still works inside, so its unsaved work is found.
exec git init -q d/repo
exec git -C d/repo commit -q --allow-empty -m init
exec git -C d/repo worktree add -q -b feature $WORK/d/wt
rm d/repo/.git/worktrees/wt/gitdir
cp dirty.txt d/wt/dirty.txt
exec lopper scan --json $WORK/d
stdout -count=1 '"path"'
stdout '"verdict": "keep"'
stdout 'gitdir is missing from '
stdout '"dirty": 1'
! stdout '"rule": "orphaned"'
# An empty link is no better.
rm d/wt/dirty.txt
cp empty d/repo/.git/worktrees/wt/gitdir
exec lopper scan --json $WORK/d
stdout 'gitdir is empty in '
stdout '"verdict": "review"'

# No HEAD in the admin directory: listed, but git cannot open it.
exec git init -q e/repo
exec git -C e/repo commit -q --allow-empty -m init
exec git -C e/repo worktree add -q -b feature $WORK/e/wt
rm e/repo/.git/worktrees/wt/HEAD
exec lopper scan --json $WORK/e
stdout -count=1 '"path"'
stdout 'HEAD is missing from '
stdout '"verdict": "review"'

-- nowhere --
../../../nowhere
-- dirty.txt --
not committed yet
-- empty --
