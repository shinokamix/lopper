# Missing historical blobs must stay unknown until the user fetches them.
exec git init -q source
cp initial.txt source/content.txt
exec git -C source add content.txt
exec git -C source commit -q -m initial
exec git -C source checkout -q -b feature
cp feature.txt source/content.txt
exec git -C source add content.txt
exec git -C source commit -q -m feature
exec git -C source checkout -q main
exec git -C source merge -q --squash feature
exec git -C source commit -q -m squash
cp base.txt source/content.txt
exec git -C source add content.txt
exec git -C source commit -q -m later
exec git -C source config uploadpack.allowFilter true

mkdir checkouts
exec git clone -q --no-local --no-checkout --filter=blob:none source checkouts/repo
exec git -C checkouts/repo checkout -q main
exec git -C checkouts/repo worktree add -q -b feature ../wt origin/feature

# Caller settings must not enable automatic downloads in lopper.
env GIT_NO_LAZY_FETCH=0
env GIT_ALLOW_PROTOCOL=file
exec lopper scan --json checkouts
stdout '"safe": false'
stdout 'could not compare with origin/main'
! stdout '"safe": true'
! stdout '"merged":'

# Plain Git can fetch the blob. Inspection then recognizes the squash.
exec git -C checkouts/wt cat-file blob main~2:content.txt
cmp stdout initial.txt
exec lopper scan --json checkouts
stdout '"merged": "content"'
stdout '"safe": true'
! stdout '"safe": false'

-- initial.txt --
one
two
three
four
five
six
-- feature.txt --
one
feature
three
four
five
six
-- base.txt --
one
feature
three
four
base
six
