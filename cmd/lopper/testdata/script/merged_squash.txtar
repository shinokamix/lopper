# Squash preserves the combined changes, rather than the original commits.
exec git init -q repo
exec git -C repo commit -q --allow-empty -m init
exec git -C repo worktree add -q -b feature ../wt
cp a.txt wt/a.txt
exec git -C wt add a.txt
exec git -C wt commit -q -m first
cp b.txt wt/b.txt
exec git -C wt add b.txt
exec git -C wt commit -q -m second

# Integrating only the first commit leaves work to keep.
exec git -C repo merge -q --squash feature~1
exec git -C repo commit -q -m partial
exec lopper scan --json $WORK
stdout '"merged": "none"'
stdout '"safe": false'
! stdout '"safe": true'

# Replace the partial integration with a real squash of both commits.
exec git -C repo reset -q --hard HEAD~1
exec git -C repo merge -q --squash feature
exec git -C repo commit -q -m squash
cp later.txt repo/later.txt
exec git -C repo add later.txt
exec git -C repo commit -q -m later
exec lopper scan --json $WORK
stdout '"merged": "content"'
stdout '"unpushed": 2'
stdout '"safe": true'
! stdout '"safe": false'

# A dirty checkout stays unsafe even though its commits were integrated.
cp local.txt wt/local.txt
exec lopper scan --json $WORK
stdout '"merged": "content"'
stdout '"safe": false'
! stdout '"safe": true'

# Committing the new work must not reuse the earlier squash match.
exec git -C wt add local.txt
exec git -C wt commit -q -m local
exec lopper scan --json $WORK
stdout '"merged": "none"'
stdout '"unpushed": 3'
stdout '"safe": false'
! stdout '"safe": true'

-- a.txt --
first change
-- b.txt --
second change
-- later.txt --
unrelated base change
-- local.txt --
work after squash
